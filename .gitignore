# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.dmypy.json
dmypy.json

# Virtual envs
.venv/
venv/
.env
.env.*
!.env.example

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*~

# Project outputs (keep directory via .gitkeep)
# Per-seed run dumps are local; proof summaries may be committed.
reports/runs/*
!reports/runs/.gitkeep
# Ignore bulk under summaries except proof JSON + README
reports/summaries/*
!reports/summaries/.gitkeep
!reports/summaries/README.md
!reports/summaries/v0_1_poc_summary.json
!reports/summaries/v1_0_package_synth_summary.json
!reports/summaries/v1_1_package_synth_summary.json
!reports/summaries/v1_1_protocol_synth_mc50_summary.json
!reports/summaries/wvs_gps_application_summary.json
!reports/.gitkeep

# Internal project-management docs: kept locally, not shipped. Tracked under
# reports/ are the math spec, the final engineering report, and proof summaries.
reports/DEVELOPMENT_PLAN*.md
reports/VERIFIED_TASK_INVENTORY.md
reports/cvprofiles_scan.md
reports/REPO_HYGIENE_REVIEW_*.md
reports/synth_v3_gate_spec.md

# Large local data (fixtures small enough to commit are OK under data/fixtures)
data/synthetic/generated/
*.parquet
!data/fixtures/**/*.parquet

# Secrets / local overrides
*.pem
credentials.json

# Hermes / agent local
.hermes/plans/

# Real-world audit run dumps (keep data/ + proof JSON; regenerate runs)
evals/realworld/**/runs_*/
evals/realworld/**/*.parquet

# WVS/GPS patience application: model GGUFs (multi-GB, never commit), smoke
# staging dirs, and API caches are regenerable. Frozen inputs under
# data/inputs/ are committed only after real prompt columns land + freeze.
evals/wvs_gps_preferences/models/
evals/wvs_gps_preferences/data/smoke_stage2/
evals/wvs_gps_preferences/data/aux/
evals/wvs_gps_preferences/data/pool_runs/

# WVS/GPS two-resolution: raw LLM `.jsonl` outputs are regenerable from the
# prompts + models/ (gitignored above). Frozen run artifacts under
# evals/wvs_gps_two_resolution/runs/ ARE committed (audit trail).
evals/wvs_gps_two_resolution/data/llm_raw/

.hermes/
data/tmp_runs/

# Local GGUF / model weights cache (downloaded ad-hoc for the WVS/GPS LLM
# extension). Top-level folder only — `evals/wvs_gps_preferences/models/`
# is already ignored separately. Add more paths here if new model caches
# appear outside `evals/`.
models/

# Default output of `cvprofiles demo` (four-file bundle + report)
/cvprofiles_demo/

# Paper build artifacts (compile locally; source only is tracked)
paper/*.aux
paper/*.log
paper/*.out
paper/*.pdf

# H5 aux caches: orphaned with the H5 lane removal (2026-08-21); local copies remain on disk
data/h5_trust_aux/
